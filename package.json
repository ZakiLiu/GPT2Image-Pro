{
  "name": "gpt2image-pro",
  "version": "0.7.0",
  "private": true,
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "test": "turbo test",
    "typecheck": "turbo typecheck",
    "lint": "turbo lint",
    "dev:web": "turbo dev --filter=@repo/web",
    "build:web": "turbo build --filter=@repo/web",
    "db:generate": "turbo db:generate --filter=@repo/database",
    "db:push": "turbo db:push --filter=@repo/database",
    "db:studio": "turbo db:studio --filter=@repo/database",
    "verify:binary-contract": "node scripts/verify-binary-deployment-contract.mjs",
    "build:binary-bundle": "node scripts/build-binary-release-bundle.mjs",
    "verify:binary-bundle": "node scripts/verify-binary-release-bundle.mjs",
    "updater:check": "node scripts/local-updater.mjs check",
    "updater:plan": "node scripts/local-updater.mjs plan",
    "updater:status": "node scripts/local-updater.mjs status",
    "updater:dry-run": "node scripts/local-updater.mjs dry-run",
    "updater:self-test:apply": "node scripts/local-updater.mjs --self-test apply"
  },
  "devDependencies": {
    "turbo": "^2.9.18"
  },
  "packageManager": "pnpm@10.27.0",
  "pnpm": {
    "overrides": {
      "kysely": "0.28.17"
    }
  },
  "license": "AGPL-3.0-only"
}
