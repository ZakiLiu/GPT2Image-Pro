{
  "id": "TASK-003",
  "title": "新增 systemd 服务模板",
  "type": "docs",
  "milestone": "M1",
  "phase": "M1-P1",
  "wave": 1,
  "depends_on": [],
  "read_first": [
    "Dockerfile.web",
