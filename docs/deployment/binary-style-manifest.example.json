{
  "version": "v0.5.7-beta.1",
  "commit": "0123456789abcdef0123456789abcdef01234567",
  "platform": "linux-x64",
  "artifact_url": "https://downloads.example.invalid/gpt2image-pro/v0.5.7-beta.1/gpt2image-pro-v0.5.7-beta.1-linux-x64.tar.gz",
  "artifact_sha256": "0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef",
  "minimum_supported_version": "v0.5.0",
  "migration_mode": "pre_switch",
  "services": {
    "web": {
      "systemd_unit": "gpt2image-web.service",
      "runtime": "next-standalone",
      "port": 3000,
      "restart_order": 1,
      "healthcheck": "web",
      "resident": true
    },
    "chatgpt-web-proxy": {
      "systemd_unit": "gpt2image-chatgpt-web-proxy.service",
      "runtime": "go-sidecar",
      "port": 3021,
      "restart_order": 2,
      "healthcheck": "chatgpt-web-proxy",
      "resident": true
    }
  },
  "migration": {
    "runner": "migrator",
    "lifecycle": "one-shot",
    "mode_source": "migration_mode",
    "resident": false
  },
  "healthcheck": {
    "web": {
      "type": "http",
      "host": "127.0.0.1",
      "port": 3000,
      "path": "/api/health",
      "expected_status": 200,
      "timeout_seconds": 5,
      "retries": 6
    },
    "chatgpt-web-proxy": {
      "type": "tcp",
      "host": "127.0.0.1",
      "port": 3021,
      "timeout_seconds": 5,
      "retries": 6
    }
  }
}
